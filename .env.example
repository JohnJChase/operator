# Copy to .env — do not commit .env.

# News refresh (weather/Open-Meteo needs no key).
NEWSDATA_API_KEY=

# Info desk (digit 8): STT + tool LLM. Piper is local.
OPENAI_API_KEY=

# Telnyx SIP outside line (digit 9) + inbound DID.
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_SIP_USER=
TELNYX_SIP_PASSWORD=
# E.164 caller ID (Telnyx number on the connection). Required for outbound.
TELNYX_CALLER_ID=

# SMS (Block 4). From defaults to TELNYX_CALLER_ID if unset.
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_SMS_FROM=
# Mission Control → Keys & Credentials → Public Key (ed25519 verify).
# If unset, local webhook accepts unsigned POSTs (sms-inject / Funnel without verify).
TELNYX_PUBLIC_KEY=
OPERATOR_SMS_WEBHOOK_PORT=8787

# Google Calendar / Meet dial-in (digit 7). Fill Client ID+secret from Cloud
# Console; refresh token from `just calendar-auth` (Block 3).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Optional: comma-separated calendar ids. Default = primary + calendars you own & selected.
# (Does not scan coworkers' shared calendars.)
# GOOGLE_CALENDAR_IDS=primary,someone@group.calendar.google.com
# GOOGLE_CALENDAR_ID=primary

# Optional LAN diagnostic console (Phase A). Requires password to enable.
OPERATOR_CONSOLE_PASSWORD=
OPERATOR_CONSOLE_PORT=8788
OPERATOR_CONSOLE_BIND=0.0.0.0

# Desktop bridge (Mac companion). Token enables /api/desktop/* on the Pi.
# Mac connects outward to the Pi with SSE; Pi pushes allowlisted intents back.
OPERATOR_DESKTOP_TOKEN=
# Digit 7 default remains the handset/PSTN path. Use desktop or auto to open Meet on Mac.
OPERATOR_MEET_JOIN_TARGET=phone
# Optional: preferred client for Meet/URL opens only. Notify fan-out ignores this.
# Blank = first online client with open_url (stable by client_id).
OPERATOR_DESKTOP_CLIENT_ID=

# Mac-side convenience vars for `just mac-client`.
OPERATOR_PI_URL=http://operator.local:8788
OPERATOR_DESKTOP_NAME=
OPERATOR_DESKTOP_NOTIFY_MODE=notification
# OPERATOR_DESKTOP_VERBOSE=1
